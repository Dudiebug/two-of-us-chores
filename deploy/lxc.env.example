# Copy to /etc/two-of-us-chores.env, owned by root with mode 0600.
# Use your real HTTPS origin and LXC private IP; no trailing URL path.
APP_ORIGIN=https://chores.example.com
LISTEN_HOST=192.0.2.50
PORT=3000
ALLOW_INSECURE_LOCALHOST=false
HOUSEHOLD_TIMEZONE=America/Los_Angeles
DATA_DIR=/var/lib/two-of-us-chores
DATABASE_PATH=/var/lib/two-of-us-chores/chores.db
BACKUP_DIR=/var/lib/two-of-us-chores/backups
# Initial passwords only: changing these later does not reset an existing account.
DYLAN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
MADY_PASSWORD=replace-with-another-unique-password-at-least-12-characters
# Set all three to enable push. Keep the same keypair across updates.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
