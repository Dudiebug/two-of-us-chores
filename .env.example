# Public URL served by the HTTPS reverse proxy.
APP_ORIGIN=https://chores.example.com
DATA_DIR=/data
DATABASE_PATH=/data/chores.db
BACKUP_DIR=/data/backups
HOUSEHOLD_TIMEZONE=America/Chicago
DYLAN_PASSWORD=replace-with-a-long-password
MADY_PASSWORD=replace-with-a-different-long-password

# Only set true for explicit localhost development; keep false in production.
ALLOW_INSECURE_LOCALHOST=false

# Optional browser push configuration. Leave all three empty to disable push.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
