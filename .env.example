# Public URL served by the HTTPS reverse proxy.
APP_ORIGIN=https://chores.example.com
# Keep this at 127.0.0.1 when the HTTPS proxy shares this host. Set it to the
# LXC's private IP only when the proxy runs in a separate guest.
BIND_ADDRESS=127.0.0.1
# Node's listening interface; leave 0.0.0.0 inside Docker. For native LXC use
# the LXC's private IP when your HTTPS proxy is in another guest.
LISTEN_HOST=0.0.0.0
DATA_DIR=/data
DATABASE_PATH=/data/chores.db
BACKUP_DIR=/data/backups
HOUSEHOLD_TIMEZONE=America/Los_Angeles
# Create the first admin and optional users with deploy/bootstrap.mjs.
# Account passwords are hashed into SQLite, not stored in this environment file.

# Only set true for explicit localhost development; keep false in production.
ALLOW_INSECURE_LOCALHOST=false

# Optional browser push configuration. Leave all three empty to disable push.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
